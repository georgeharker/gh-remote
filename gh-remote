#!/usr/bin/env bash

set -e

# gh-remote: GitHub CLI extension for managing git remotes
# Usage: gh remote <subcommand> [options]

VERSION="1.0.0"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default values
VISIBILITY="private"
WORK_DIR="."

# Helper functions
error() {
    echo -e "${RED}Error:${NC} $1" >&2
    exit 1
}

success() {
    echo -e "${GREEN}✓${NC} $1"
}

info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

warn() {
    echo -e "${YELLOW}⚠${NC} $1"
}

show_help() {
    cat << EOF
gh-remote v${VERSION}

Simplify repository and git remote management for GitHub.

USAGE
    gh remote <subcommand> [options]

SUBCOMMANDS
    new <repo>              Create a new repository and set it as origin
    set <repo>              Set an existing repository as origin (with fork detection)

OPTIONS
    --public                Create a public repository (for 'new' command)
    --private               Create a private repository (default for 'new')
    --directory <path>      Work in the specified directory (default: current directory)
    -h, --help              Show this help message
    -v, --version           Show version information

REPOSITORY FORMATS
    user/repo               Repository in user/repo format
    https://github.com/...  Full GitHub URL
    git@github.com:...      SSH URL

EXAMPLES
    # Create a new private repository
    gh remote new my-project

    # Create a new public repository with description
    gh remote new my-project --public

    # Set existing repository as origin
    gh remote set octocat/hello-world

    # Set repository using full URL
    gh remote set https://github.com/octocat/hello-world

    # Work in a different directory
    gh remote new my-project --directory ~/projects/my-app

    # Set a forked repository (automatically sets upstream)
    gh remote set myuser/forked-repo

DESCRIPTION
    This extension helps you quickly set up git remotes for your projects:

    'gh remote new' - Creates a new GitHub repository and sets it as origin
    'gh remote set' - Sets an existing repository as origin
                      - Automatically detects forks and sets upstream remote

    The extension will initialize a git repository if one doesn't exist.

EOF
}

show_version() {
    echo "gh-remote v${VERSION}"
}

# Check if gh CLI is installed
check_gh_installed() {
    if ! command -v gh &> /dev/null; then
        error "GitHub CLI (gh) is not installed. Install it from https://cli.github.com/"
    fi

    # Check if user is authenticated
    if ! gh auth status &> /dev/null; then
        error "Not authenticated with GitHub. Run 'gh auth login' first."
    fi
}

# Ensure directory is a git repository
ensure_git_repo() {
    cd "$WORK_DIR" || error "Directory $WORK_DIR does not exist"

    if [ ! -d .git ]; then
        info "Not a git repository. Initializing..."
        git init
        success "Initialized git repository in $WORK_DIR"
    else
        info "Git repository already exists"
    fi
}

# Parse repository identifier and convert to user/repo format
parse_repo_identifier() {
    local repo="$1"

    # If it's already in user/repo format
    if [[ "$repo" =~ ^[a-zA-Z0-9_-]+/[a-zA-Z0-9_-]+$ ]]; then
        echo "$repo"
        return
    fi

    # If it's a GitHub HTTPS URL
    if [[ "$repo" =~ ^https://github\.com/([^/]+)/(.+)$ ]]; then
        local repo_name="${BASH_REMATCH[2]}"
        # Strip .git suffix if present
        repo_name="${repo_name%.git}"
        echo "${BASH_REMATCH[1]}/${repo_name}"
        return
    fi

    # If it's a GitHub SSH URL
    if [[ "$repo" =~ ^git@github\.com:([^/]+)/(.+)$ ]]; then
        local repo_name="${BASH_REMATCH[2]}"
        # Strip .git suffix if present
        repo_name="${repo_name%.git}"
        echo "${BASH_REMATCH[1]}/${repo_name}"
        return
    fi

    # Otherwise, return as-is and let gh handle it
    echo "$repo"
}

# Get SSH URL for a repository
get_ssh_url() {
    local repo="$1"
    gh repo view "$repo" --json sshUrl -q .sshUrl 2>/dev/null
}

# Check if a repository is a fork
is_fork() {
    local repo="$1"
    local parent
    parent=$(gh repo view "$repo" --json parent -q .parent.nameWithOwner 2>/dev/null)
    echo "$parent"
}

# Setup git remotes
setup_remotes() {
    local origin_url="$1"
    local upstream_url="$2"

    cd "$WORK_DIR" || error "Directory $WORK_DIR does not exist"

    # Check if origin already exists
    if git remote get-url origin &> /dev/null; then
        warn "Remote 'origin' already exists"
        read -p "Do you want to replace it? (y/N): " replace
        if [[ ! $replace =~ ^[Yy]$ ]]; then
            info "Skipping origin setup"
            return
        fi
        git remote remove origin
    fi

    # Set origin
    git remote add origin "$origin_url"
    success "Set remote 'origin' to $origin_url"

    # Set upstream if provided
    if [ -n "$upstream_url" ]; then
        if git remote get-url upstream &> /dev/null; then
            warn "Remote 'upstream' already exists"
            read -p "Do you want to replace it? (y/N): " replace
            if [[ ! $replace =~ ^[Yy]$ ]]; then
                info "Skipping upstream setup"
                return
            fi
            git remote remove upstream
        fi

        git remote add upstream "$upstream_url"
        success "Set remote 'upstream' to $upstream_url"
    fi

    echo ""
    info "Current remotes:"
    git remote -v
}

# Subcommand: new - Create a new repository
cmd_new() {
    local repo_name="$1"

    if [ -z "$repo_name" ]; then
        error "Repository name is required.\nUsage: gh remote new <repo-name> [options]"
    fi

    info "Creating repository: $repo_name"

    # Build gh repo create command
    local cmd="gh repo create $repo_name --$VISIBILITY"

    # Create the repository
    info "Creating repository..."
    eval "$cmd" || error "Failed to create repository"

    # Get the full repo name (username/repo_name)
    local username
    username=$(gh api user -q .login)
    local full_repo_name="$username/$repo_name"

    success "Created repository: $full_repo_name"

    # Get SSH URL
    local ssh_url
    ssh_url=$(get_ssh_url "$full_repo_name")

    if [ -z "$ssh_url" ]; then
        error "Failed to get SSH URL for repository"
    fi

    # Ensure git repo and set remote
    ensure_git_repo
    setup_remotes "$ssh_url" ""

    echo ""
    success "Done!"
}

# Subcommand: set - Set an existing repository as origin
cmd_set() {
    local repo="$1"

    if [ -z "$repo" ]; then
        error "Repository identifier is required.\nUsage: gh remote set <user/repo|url> [options]"
    fi

    # Parse the repository identifier
    local parsed_repo
    parsed_repo=$(parse_repo_identifier "$repo")

    info "Setting remote for repository: $parsed_repo"

    # Get SSH URL
    local ssh_url
    ssh_url=$(get_ssh_url "$parsed_repo")

    if [ -z "$ssh_url" ]; then
        error "Failed to get repository information. Make sure the repository exists and you have access."
    fi

    # Check if it's a fork
    local upstream_repo
    upstream_repo=$(is_fork "$parsed_repo")

    if [ -n "$upstream_repo" ]; then
        info "This is a fork of $upstream_repo"
        local upstream_url
        upstream_url=$(get_ssh_url "$upstream_repo")

        # Ensure git repo and set remotes
        ensure_git_repo
        setup_remotes "$ssh_url" "$upstream_url"
    else
        # Ensure git repo and set remote
        ensure_git_repo
        setup_remotes "$ssh_url" ""
    fi

    echo ""
    success "Done!"
}

# Main function
main() {
    # Check prerequisites first
    check_gh_installed

    # Parse subcommand
    local subcommand=""
    local repo_arg=""

    while [[ $# -gt 0 ]]; do
        case $1 in
            new|set)
                subcommand="$1"
                shift
                # Next argument should be repo name/identifier
                if [[ $# -gt 0 ]] && [[ ! "$1" =~ ^- ]]; then
                    repo_arg="$1"
                    shift
                fi
                ;;
            --public)
                VISIBILITY="public"
                shift
                ;;
            --private)
                VISIBILITY="private"
                shift
                ;;
            --directory)
                WORK_DIR="$2"
                shift 2
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            *)
                error "Unknown option: $1\nUse --help for usage information."
                ;;
        esac
    done

    # Execute subcommand
    case $subcommand in
        new)
            cmd_new "$repo_arg"
            ;;
        set)
            cmd_set "$repo_arg"
            ;;
        "")
            error "Subcommand required.\nUsage: gh remote <new|set> <repo> [options]\nUse --help for more information."
            ;;
        *)
            error "Unknown subcommand: $subcommand\nUse --help for usage information."
            ;;
    esac
}

# Run main function
main "$@"
